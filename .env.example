# Application
NEXT_PUBLIC_APP_NAME=KinteHobe
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=your_better_auth_api_key

# Email
MAILER_API_KEY=your_mailer_api_key

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# SSLCommerz
SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWORD=your_store_password

# Sentry
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# hCaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_hcaptcha_site_key
CAPTCHA_SECRET_KEY=your_hcaptcha_secret_key
